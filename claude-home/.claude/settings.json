{
  "permissions": {
    "allow": [
      "Read(~/CLAUDE.md)",
      "Read(~/code/**)",
      "Edit(~/code/**)",
      "Read(~/oss/**)",
      "Edit(~/oss/**)",
      "Read(~/worktrees/**)",
      "Edit(~/worktrees/**)",
      "Read(~/notebooks/**)",
      "Edit(~/notebooks/**)",
      "Read(~/datasets/**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(uv:*)",
      "Bash(make:*)",
      "Bash(cargo:*)",
      "WebFetch"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  }
}
